<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <rect width="1200" height="630" fill="#0A0A0A"/>
  <rect width="1200" height="3" y="0" fill="#C9A84C"/>
  <rect width="1200" height="3" y="627" fill="#C9A84C"/>
  <rect width="3" height="630" x="0" fill="#C9A84C"/>
  <rect width="3" height="630" x="1197" fill="#C9A84C"/>
  <!-- Decorative lines -->
  <line x1="80" y1="200" x2="80" y2="430" stroke="#C9A84C" stroke-width="1" opacity="0.4"/>
  <line x1="1120" y1="200" x2="1120" y2="430" stroke="#C9A84C" stroke-width="1" opacity="0.4"/>
  <!-- Brand mark -->
  <text x="600" y="240" font-family="Georgia, serif" font-size="18" fill="#C9A84C" text-anchor="middle" letter-spacing="8" opacity="0.8">LONDRINA EXECUTIVO</text>
  <!-- Divider -->
  <rect x="540" y="265" width="120" height="1" fill="#C9A84C" opacity="0.6"/>
  <!-- Main title -->
  <text x="600" y="340" font-family="Georgia, serif" font-size="56" fill="#F0F0F0" text-anchor="middle" font-weight="bold">Transporte Executivo</text>
  <!-- Subtitle -->
  <text x="600" y="400" font-family="Georgia, serif" font-size="24" fill="#A8A8A8" text-anchor="middle">Rotas Interestaduais</text>
  <!-- Bottom label -->
  <text x="600" y="530" font-family="Georgia, serif" font-size="14" fill="#6B6B6B" text-anchor="middle" letter-spacing="3">londrinaexecutivo.com.br</text>
</svg>